# COLLABMATRIX — SUPABASE POSTGRESQL CONFIGURATION
# Copy this file to .env.local and replace with your real project credentials from Supabase Dashboard -> Project Settings -> API.
# WARNING: NEVER commit .env.local or expose service-role keys in this frontend file.

# 1. Project URL (e.g., https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Public Anonymous Key (safe for browser client-side use with Row Level Security)
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_legacy_anon_key
